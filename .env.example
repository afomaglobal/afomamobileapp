# Copy to .env for local development. Do not commit real credentials.
# Production values belong in EAS environment secrets (Expo dashboard), not in the repo.

# development | preview | production
# EAS: development + preview profiles share one STG backend (same EXPO_PUBLIC_* in each EAS environment).
# eas.json sets EXPO_PUBLIC_APP_ENV per profile; validateAppEnv enforces STG vs production hosts.
EXPO_PUBLIC_APP_ENV=development

# STG (development & preview builds) — keep in sync with EAS development/preview environments
EXPO_PUBLIC_API_URL=https://development.afomamarketplace.com
EXPO_PUBLIC_SOCKET_URL=https://development.afomamarketplace.com
EXPO_PUBLIC_STOREFRONT_URL=https://staging.afomamarketplace.com
EXPO_PUBLIC_WEB_URL=https://development.afomamarketplace.com

# Production builds (EAS production environment — not committed):
# EXPO_PUBLIC_API_URL=https://api.afomamarketplace.com
# EXPO_PUBLIC_SOCKET_URL=https://api.afomamarketplace.com
# EXPO_PUBLIC_STOREFRONT_URL=https://afomamarketplace.com
# EXPO_PUBLIC_WEB_URL=https://afomamarketplace.com
# EXPO_PUBLIC_PAYPAL_AUTH_REDIRECT_URL=https://afomamarketplace.com
# See store/PRODUCTION_READINESS.md

EXPO_PUBLIC_PAYPAL_CLIENT_ID=
EXPO_PUBLIC_PAYPAL_RETURN_URL=afoma://checkout/paypal
EXPO_PUBLIC_PAYPAL_AUTH_REDIRECT_URL=https://www.example.com

EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=merchant.com.afoma

EXPO_PUBLIC_KORAPAY_RETURN_URL=afoma://checkout/korapay

# Optional — enable when Sentry is configured in EAS
# EXPO_PUBLIC_SENTRY_DSN=
# EAS builds: set SENTRY_AUTH_TOKEN + org/project on the @sentry/react-native plugin, then remove
# SENTRY_DISABLE_AUTO_UPLOAD from eas.json to upload debug symbols. Until then, auto-upload stays off.
